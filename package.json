{
  "name": "beforeyousign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rimraf .next tsconfig.tsbuildinfo *.log",
    "fresh": "rimraf .next tsconfig.tsbuildinfo *.log && next dev",
    "verify": "npm run lint && npx tsc --noEmit && npm run build",
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/unit/drafter-parsing.test.ts tests/unit/extract-message.test.ts tests/unit/parse-json.test.ts",
    "test:pdf": "node --experimental-strip-types --no-warnings scripts/run-smoke.mjs",
    "test": "npm run test:unit && npm run test:pdf",
    "verify:unit": "npm run test:unit"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.3",
    "@google/generative-ai": "^0.21.0",
    "@napi-rs/canvas": "^0.1.100",
    "@pdfsmaller/pdf-encrypt-lite": "^1.2.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/bcryptjs": "^2.4.6",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "diff-match-patch": "^1.0.5",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.556.0",
    "mammoth": "^1.11.0",
    "mupdf": "^1.28.1",
